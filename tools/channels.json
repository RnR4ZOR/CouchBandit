    "AFL": [{ "handle": "@AFL" }],
    "NBA": [{ "handle": "@NBA" }],
    "NFL": [{ "handle": "@NFL" }],
    "Tennis": [{ "handle": "@ATPTour" }, { "handle": "@WTA" }, { "handle": "@AustralianOpen" }]
  }
}
