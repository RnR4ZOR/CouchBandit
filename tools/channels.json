{
  "_note": "Official channels Couch Bandit watches for scheduled live streams. Add or remove handles freely. 'alts' are extra official links (e.g. a Twitch channel) added as backups. Max 5 backups per event.",
  "days_ahead": 14,
  "skip_titles": "highlights|recap|full fight|best of|compilation|reaction|trailer|teaser",
